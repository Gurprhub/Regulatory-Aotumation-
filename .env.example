# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- database ---------------------------------------------------------------
POSTGRES_USER=regulatory
POSTGRES_DB=regulatory
# Required. Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- the app ----------------------------------------------------------------
PORT=8000
WEB_CONCURRENCY=4

# MUST be true anywhere the app is reached over HTTPS. Left false here because
# the compose stack serves plain HTTP on localhost.
SESSION_COOKIE_SECURE=false

SESSION_HOURS=12
CRITICAL_DAYS=30
WARNING_DAYS=90

# --- first administrator ----------------------------------------------------
# Only used while the database has no accounts at all; ignored afterwards.
# Prefer leaving these empty and running:  docker compose exec app python -m scripts.create_admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
